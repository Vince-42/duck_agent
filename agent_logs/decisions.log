  "content": "#!/usr/bin/env python3\n\nimport argparse\nimport json\nimport os\nfrom collections import defaultdict\n\n\ndef parse_file(input_file):\n    try:\n        with open(input_file, 'r') as file:\n            lines = file.readlines()\n            data = [line.strip().split(',') for line in lines if not line.startswith('#')]\n            return data\n    except FileNotFoundError:\n        print(json.dumps({'error': 'File not found'}))\n        exit(1)\n\n\ndef summarize_data(data, region=None, top=None):\n    result = {\n        'record_count': len(data),\n        'region_filter': region,\n        'total_revenue': 0,\n        'revenue_by_region': defaultdict(float),\n        'top_products': [],\n        'errors': []\n    }\n\n    for i, line in enumerate(data):\n        if len(line) != 3:\n            result['errors'].append({'line_number': i + 1, 'error': 'Invalid number of fields'})\n            continue\n\n        product, region, revenue = line\n        try:\n            revenue = float(revenue)\n        except ValueError:\n            result['errors'].append({'line_number': i + 1, 'error': 'Non-numeric revenue value'})\n            continue\n\n        result['total_revenue'] += revenue\n        result['revenue_by_region'][region] += revenue\n\n    if region:\n        result['revenue_by_region'] = {r: rev for r, rev in result['revenue_by_region'].items() if r == region}\n\n    if top is not None and top > 0:\n        products_by_revenue = sorted(result['revenue_by_region'].items(), key=lambda x: x[1], reverse=True)\n        result['top_products'] = [{'region': r, 'revenue': rev} for r, rev in products_by_revenue[:top]]\n\n    return result\n\n\ndef main():\n    parser = argparse.ArgumentParser(description='Summarize sales data from a file.')\n    parser.add_argument('input_file', type=str, help='Path to the input file.')\n    parser.add_argument('--region', type=str, help='Filter results by region.')\n    parser.add_argument('--top', type=int, help='Show top N regions with highest revenue.')\n\n    args = parser.parse_args()\n    data = parse_file(args.input_file)\n    result = summarize_data(data, region=args.region, top=args.top)\n    print(json.dumps(result))\n\nif __name__ == '__main__':\n    main()"
}
