  "content": "#!/usr/bin/env python3\n\nimport argparse\nimport json\nfrom collections import Counter\nimport string\n\ndef read_file(file_path):\n    try:\n        with open(file_path, 'r', encoding='utf-8') as file:\n            return file.read()\n    except FileNotFoundError:\n        print(json.dumps({'error': 'File not found'}))\n        exit(1)\n\ndef count_words(text):\n    words = text.lower().translate(str.maketrans('', '', string.punctuation)).split()\n    return Counter(words)\n\nif __name__ == '__main__':\n    parser = argparse.ArgumentParser(description='Analyze a text file and print statistics.')\n    parser.add_argument('input_file', type=str, help='Path to the input UTF-8 text file')\n    parser.add_argument('--top', type=int, default=5, help='Number of top words to return (default: 5)')\n\n    args = parser.parse_args()\n\n    content = read_file(args.input_file)\n    word_count = len(content.split())\n    char_count = len(content)\n    line_count = content.count('\n') + 1\n    top_words = [{'word': word, 'count': count} for word, count in count_words(content).most_common(args.top)]\n\n    result = {\n        'line_count': line_count,\n        'word_count': word_count,\n        'char_count': char_count,\n        'top_words': top_words\n    }\n\n    print(json.dumps(result))"
