#!/usr/bin/env python3

import sys
import json

def main():
    if len(sys.argv) != 2:
        print(json.dumps({'error': 'Usage: python3 knit.py compile <input_file>'}), file=sys.stderr)
        sys.exit(1)
    input_file = sys.argv[1]
    try:
        with open(input_file, 'r') as f:
            content = f.read()
            print(json.dumps({'content': content}))
    except FileNotFoundError:
        print(json.dumps({'error': 'File not found'}), file=sys.stderr)
        sys.exit(1)

if __name__ == '__main__':
    main()
