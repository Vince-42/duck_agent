## Option A: Python Agent (Recommended for Speed)

### Step 1: Install Ollama & Model (15 min)

```bash
# Install Ollama from https://ollama.ai
# Then pull a code-focused model:

ollama pull qwen2.5-coder:7b
# or
ollama pull llama2-uncensored:7b
# or
ollama pull mistral:7b

# Start Ollama server (runs on localhost:11434)
ollama serve
```

### Step 2: Create Agent Script (30 min)

```python
# agent.py
import subprocess
import json
import os
import requests
from datetime import datetime

class Agent:
    def __init__(self, spec_path="secret_spec/SECRET_SPEC.md", max_iterations=20):
        self.spec_path = spec_path
        self.max_iterations = max_iterations
        self.iteration = 0
        self.model = "qwen2.5-coder:7b"
        self.ollama_url = "http://localhost:11434/api/generate"
        self.setup_logs()
    
    def setup_logs(self):
        """Create log directory and files"""
        os.makedirs("agent_logs", exist_ok=True)
        self.log_files = {
            "prompts": open("agent_logs/prompts.log", "a"),
            "decisions": open("agent_logs/decisions.log", "a"),
            "commands": open("agent_logs/commands.log", "a"),
            "test_runs": open("agent_logs/test_runs.log", "a"),
            "errors": open("agent_logs/errors.log", "a"),
        }
    
    def log(self, category, message):
        """Write timestamped log entry"""
        timestamp = datetime.now().isoformat()
        entry = f"[{timestamp}] {message}\n"
        if category in self.log_files:
            self.log_files[category].write(entry)
            self.log_files[category].flush()
        print(f"[{category.upper()}] {message}")
    
    def read_spec(self):
        """Read the hidden specification"""
        if not os.path.exists(self.spec_path):
            self.log("errors", f"Spec not found at {self.spec_path}")
            return None
        with open(self.spec_path, "r") as f:
            spec = f.read()
        self.log("decisions", "Read specification from file")
        return spec
    
    def call_model(self, prompt):
        """Call Ollama model with a prompt"""
        try:
            response = requests.post(
                self.ollama_url,
                json={"model": self.model, "prompt": prompt, "stream": False}
            )
            if response.status_code == 200:
                return response.json()["response"]
            else:
                self.log("errors", f"Model call failed: {response.status_code}")
                return None
        except Exception as e:
            self.log("errors", f"Model exception: {e}")
            return None
    
    def run_tests(self):
        """Run the public test suite"""
        try:
            result = subprocess.run(
                ["python3", "secret_spec/test_runner/run_tests.py", 
                 "--program", "python3 solution.py", "--suite", "public"],
                capture_output=True,
                text=True,
                timeout=60
            )
            output = result.stdout + result.stderr
            self.log("test_runs", f"Test output:\n{output}")
            return output
        except subprocess.TimeoutExpired:
            self.log("errors", "Test run timed out")
            return None
        except Exception as e:
            self.log("errors", f"Test run failed: {e}")
            return None
    
    def run_command(self, cmd):
        """Run arbitrary shell command"""
        try:
            result = subprocess.run(
                cmd, shell=True, capture_output=True, text=True, timeout=30
            )
            self.log("commands", f"Ran: {cmd}")
            self.log("commands", f"Result: {result.stdout}\n{result.stderr}")
            return result.stdout, result.stderr, result.returncode
        except Exception as e:
            self.log("errors", f"Command failed: {cmd} -> {e}")
            return None, str(e), 1
    
    def create_file(self, path, content):
        """Create or overwrite a file"""
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w") as f:
                f.write(content)
            self.log("decisions", f"Created/updated file: {path}")
            return True
        except Exception as e:
            self.log("errors", f"Failed to create {path}: {e}")
            return False
    
    def get_next_action(self, context):
        """Ask model what to do next"""
        prompt = f"""
You are an autonomous coding agent. You are implementing a solution to this specification:

{context['spec']}

Current iteration: {self.iteration}

Last test results:
{context.get('last_test_output', 'No tests run yet')}

What is the next action you should take?

You can choose one of:
1. EDIT_FILE path="..." with code
2. RUN_TESTS to see current state
3. RUN_COMMAND cmd="..."
4. COMPLETE (if task is done)

Respond in this format:
ACTION: [action name]
DETAILS: [details for that action]
REASONING: [why this action]
"""
        self.log("prompts", f"Asking model for next action:\n{prompt}")
        response = self.call_model(prompt)
        self.log("decisions", f"Model response:\n{response}")
        return response
    
    def main_loop(self):
        """Main agent loop"""
        spec = self.read_spec()
        if not spec:
            self.log("errors", "Cannot proceed without spec")
            return
        
        context = {
            "spec": spec,
            "last_test_output": None,
        }
        
        self.log("decisions", "Starting main agent loop")
        
        while self.iteration < self.max_iterations:
            print(f"\n{'='*60}")
            print(f"ITERATION {self.iteration}")
            print(f"{'='*60}")
            
            # Get next action from model
            action_response = self.get_next_action(context)
            if not action_response:
                self.log("errors", "Model did not respond")
                break
            
            # Parse action (simple text parsing)
            action_upper = action_response.upper()
            
            if "COMPLETE" in action_upper:
                self.log("decisions", "Model decided task is complete")
                break
            
            if "RUN_TESTS" in action_upper:
                test_output = self.run_tests()
                context["last_test_output"] = test_output
            
            elif "EDIT_FILE" in action_upper:
                # Extract path and code (simplified)
                lines = action_response.split("\n")
                path_line = [l for l in lines if "path=" in l.lower()]
                if path_line:
                    # Very simple extraction - in reality you'd use JSON
                    path = path_line[0].split('"')[1]
                    # Get all code after "with code"
                    code_start = action_response.find("with code") + 9
                    code = action_response[code_start:].split("REASONING:")[0].strip()
                    self.create_file(path, code)
            
            elif "RUN_COMMAND" in action_upper:
                cmd_line = [l for l in action_response.split("\n") if "cmd=" in l.lower()]
                if cmd_line:
                    cmd = cmd_line[0].split('"')[1]
                    self.run_command(cmd)
            
            self.iteration += 1
        
        self.log("decisions", f"Loop ended at iteration {self.iteration}")
        self.close_logs()
    
    def close_logs(self):
        """Close all log files"""
        for f in self.log_files.values():
            f.close()

if __name__ == "__main__":
    agent = Agent()
    agent.main_loop()
```

### Step 3: Test with Toy Task (15 min)

```bash
# Create a simple test task
mkdir -p test_task
cd test_task

# Create a fake spec
cat > spec.md << 'EOF'
# Build a Simple Adder

Create a Python program that:
1. Takes two numbers as arguments
2. Adds them
3. Prints the result

Example:
$ python solution.py 3 5
8
EOF

# Run agent
python agent.py --spec spec.md
```

