from langchain_community.llms import Ollama
from langchain.agents import initialize_agent, Tool
import subprocess

llm = Ollama(model="qwen2.5-coder:7b")

tools = [
    Tool(
        name="run_tests",
        func=lambda: subprocess.run(["python3", "secret_spec/test_runner/run_tests.py", 
                                     "--program", "python3 solution.py", "--suite", "public"],
                                   capture_output=True, text=True).stdout,
        description="Run public tests to check progress"
    ),
    Tool(
        name="create_file",
        func=lambda path, code: open(path, "w").write(code),
        description="Create or edit a file with code"
    ),
]

