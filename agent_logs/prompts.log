### Simpler: Just Use Requests + JSON
```python
import requests
import json

def agent_call(prompt, action_format="json"):
    """Call model and parse structured response"""
    response = requests.post(
        "http://localhost:11434/api/generate",
        json={
            "model": "qwen2.5-coder:7b",
            "prompt": f"{prompt}\n\nRespond in JSON format with 'action', 'details', 'reasoning'",
            "stream": False,
            "format": "json" if action_format == "json" else None
        }
    )
    return json.loads(response.json()["response"])
