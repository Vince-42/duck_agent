    parser = argparse.ArgumentParser(description='Text statistics program')
    parser.add_argument('input_file', help='Path to the input text file')
    parser.add_argument('--top', type=int, default=5, help='Number of top words to return')
    args = parser.parse_args()

    text = read_file(args.input_file)
    word_count = process_text(text)

    result = {
        'line_count': len(text.splitlines()),
        'word_count': sum(word_count.values()),
        'char_count': len(''.join(filter(str.isalnum, text))),
        'top_words': [{'word': word, 'count': count} for word, count in word_count.most_common(args.top)]
    }

    print(json.dumps(result))
